LOG_LEVEL=debug
ECPAY_ENV=stage

# 綠界的測試環境不能自行註冊，只能用官方文件公布的測試特店。
# 這組是全球開發者共用的 —— 所以 MerchantTradeNo 一定要用高熵亂碼，
# 流水號會撞到陌生人的訂單。
ECPAY_MERCHANT_ID=3002607

# 這個環境實際開通了什麼，由設定決定而不是程式寫死。
ECPAY_ALLOWED_PAYMENTS=Credit,WebATM,ATM,CVS,BARCODE

# 各付款方式的金額下限。綠界的開發文件沒有公布這些數字（在合約與費率頁、
# 依商店而異），所以不寫死在程式裡 —— 這組是對測試特店 3002607 實測出來的
# （scripts/probe-limits.py，邊界都確認過：CVS 26 不行 27 可以）。
# 沒列到的付款方式不擋。
ECPAY_MIN_AMOUNTS=ATM:2,WebATM:2,CVS:27,BARCODE:16

# 示範商店 /demo —— 付款者實際會走的那條路（導轉、收銀台、導回）只有用
# 真的瀏覽器走一遍才驗得到，curl 驗不到。
# ⚠️ **prod 刻意沒有這一行**，沒設就整組端點 404。
DEMO_CALLER_ID=demo-storefront
