ECPAY_TIMEOUT_SECONDS=10
DB_POOL_MAX=3
# 借不到連線就等這麼久，然後 503。刻意不無限等 —— 見 app/db.py。
DB_POOL_TIMEOUT_SECONDS=5

# --- 事件主動推送 ---
# 打 caller 端點的 timeout
WEBHOOK_TIMEOUT_SECONDS=10
# ⚠️ 建 Cloud Task 是一次對外 HTTP，而它就在回綠界 1|OK 的路徑上。
# Cloud Tasks API 一慢，ACK 就慢，綠界超時就重送 —— 事故當下再加一輪流量。
# 逾時就交給 sweep 補（重複投遞是至少一次語意涵蓋得了的）。
WEBHOOK_ENQUEUE_TIMEOUT_SECONDS=2
# per-caller queue 是 {prefix}-{消毒後的 caller}-{雜湊}；prefix 本身是退路用的共用 queue。
# 環境靠 project ID 識別（向 metadata server 要），queue 名字不需要跟著分環境。
TASKS_QUEUE_PREFIX=payment-ecpay-deliveries
TASKS_LOCATION=asia-east1
# ⚠️ 這裡刻意**沒有** WEBHOOK_MAX_ATTEMPTS。重試次數與窗口的唯一真相是
# queue 的 retryConfig，sweep 需要那個數字時向 queue 本人要。
# 留一個 env 就是留第二份真相，而沒有任何東西在守它們一致 ——
# 症狀會是「死信永遠不會被標記」，也就是那個欄位存在的唯一理由消失。
