ECPAY_HASH_KEY=payment-ecpay-hash-key-prod:latest
ECPAY_HASH_IV=payment-ecpay-hash-iv-prod:latest

# 商家檢查碼（後台：信用卡收單 → 信用卡授權資訊）。
# 只有 CreditDetail/QueryTrade/V2「查詢信用卡單筆明細」需要它 ——
# 那支會回授權/關帳/取消狀態與已關帳金額，而且**只有正式環境有**。
# dev 刻意沒有對應設定（共用測試特店連信用卡收單後台都沒權限）。
ECPAY_CREDIT_CHECK_CODE=payment-ecpay-credit-check-code-prod:latest

# 事件推送。**缺席時服務照常啟動，只是推送關閉**（/health 的 push 會說）——
# 第一次部署時 secret 還沒建，硬性必填會讓服務起不來，
# 而沒有推送的服務仍然是完全可用的服務（GET /v1/events 還在）。
WEBHOOK_SIGNING_KEY=payment-ecpay-webhook-signing-key-prod:latest
INTERNAL_KEY=payment-ecpay-internal-key-prod:latest
