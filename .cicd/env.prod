LOG_LEVEL=info
ECPAY_ENV=production

# Adam Studio（個人賣家）。已開通：信用卡（僅國內卡）、非信用卡收款。
# 未開通：TWQR、微信支付。海外卡因帳號資格不支援。
ECPAY_MERCHANT_ID=3017099

ECPAY_ALLOWED_PAYMENTS=Credit,WebATM,ATM,CVS,BARCODE

# 正式商店的金額下限**還沒量**。刻意留空（不設就不擋），因為填錯的方向
# 是「誤擋合法訂單」，比不擋更糟。要量的話：
#   ECPAY_HASH_KEY=… ECPAY_HASH_IV=… ECPAY_MERCHANT_ID=3017099 \
#   ECPAY_HOST=https://payment.ecpay.com.tw python3 scripts/probe-limits.py
# 代價是後台會多出數十筆未付款的探測訂單（不扣款、不計費）。
# ECPAY_MIN_AMOUNTS=
